# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 견적 문의 네이버폼 링크
NEXT_PUBLIC_NAVER_FORM_URL=your_naver_form_url

# 사이트 절대 URL (SEO/sitemap용) — 실제 배포 도메인
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 견적 문의 접수 알림 메일 (네이버 SMTP)
#  메일 → 환경설정 → POP3/IMAP → SMTP 사용함
#  네이버 계정 → 보안설정 → 애플리케이션 비밀번호
NAVER_MAIL_USER=your_id@naver.com
NAVER_MAIL_PASS=your_app_password
MAIL_TO=event-land@naver.com
